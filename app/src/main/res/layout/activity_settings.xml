<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dadway_content_padding"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/dadway_content_padding"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/settingsBackButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Назад"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/dadway_text"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Настройки"
                android:textColor="@color/dadway_text"
                android:textSize="22sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Подключение"
            android:textColor="@color/dadway_text"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_group_bg"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/subscriptionsSettingsRow"
                style="@style/DadwaySettingsRow">
                <ImageView style="@style/DadwaySettingsIcon" android:contentDescription="Подписки"
                    android:src="@drawable/ic_subscription" app:tint="@color/dadway_primary"/>
                <LinearLayout style="@style/DadwaySettingsTextGroup">
                    <TextView style="@style/DadwaySettingsTitle" android:text="Управление подписками"/>
                    <TextView style="@style/DadwaySettingsSubtitle" android:text="Добавление и включение источников"/>
                </LinearLayout>
                <ImageView style="@style/DadwaySettingsChevron"/>
            </LinearLayout>

            <View style="@style/DadwaySettingsDivider"/>

            <LinearLayout
                android:id="@+id/appRoutingSettingsRow"
                style="@style/DadwaySettingsRow">
                <ImageView style="@style/DadwaySettingsIcon" android:contentDescription="Приложения"
                    android:src="@drawable/ic_apps" app:tint="@color/dadway_primary"/>
                <LinearLayout style="@style/DadwaySettingsTextGroup">
                    <TextView style="@style/DadwaySettingsTitle" android:text="Приложения через VPN"/>
                    <TextView android:id="@+id/routingSummary" style="@style/DadwaySettingsSubtitle" android:text="Все приложения"/>
                </LinearLayout>
                <ImageView style="@style/DadwaySettingsChevron"/>
            </LinearLayout>

            <View style="@style/DadwaySettingsDivider"/>

            <LinearLayout
                android:id="@+id/refreshServersSettingsRow"
                style="@style/DadwaySettingsRow">
                <ImageView style="@style/DadwaySettingsIcon" android:contentDescription="Обновить"
                    android:src="@drawable/ic_refresh" app:tint="@color/dadway_primary"/>
                <LinearLayout style="@style/DadwaySettingsTextGroup">
                    <TextView style="@style/DadwaySettingsTitle" android:text="Обновить серверы"/>
                    <TextView style="@style/DadwaySettingsSubtitle" android:text="Проверить подписки и доступность"/>
                </LinearLayout>
                <ImageView style="@style/DadwaySettingsChevron"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Telegram"
            android:textColor="@color/dadway_text"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/proxy_card_bg"
            android:orientation="vertical"
            android:padding="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/proxy_icon_bg"
                    android:contentDescription="SOCKS5"
                    android:padding="10dp"
                    android:src="@drawable/ic_server"
                    app:tint="@color/white"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Локальный SOCKS5"
                        android:textColor="@color/dadway_text"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="127.0.0.1:10808"
                        android:textColor="@color/dadway_text"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <ImageButton
                    android:id="@+id/copyProxyButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Скопировать ссылку SOCKS5"
                    android:padding="13dp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/dadway_text_secondary"/>
            </LinearLayout>
            <TextView
                android:id="@+id/proxyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="54dp"
                android:layout_marginTop="4dp"
                android:text="●  Запустите VPN для подключения"
                android:textColor="@color/dadway_text_secondary"
                android:textSize="11sp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/telegramProxyButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="Подключить в Telegram"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:backgroundTint="@color/dadway_primary"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_telegram"
                app:iconGravity="textStart"
                app:iconTint="@color/white"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="middle"
                android:gravity="center"
                android:maxLines="1"
                android:text="tg://socks?server=127.0.0.1&amp;port=10808"
                android:textColor="@color/dadway_text_secondary"
                android:textIsSelectable="true"
                android:textSize="9sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Оформление"
            android:textColor="@color/dadway_text"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_group_bg"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/themeSettingsRow"
                style="@style/DadwaySettingsRow">
                <ImageView style="@style/DadwaySettingsIcon" android:contentDescription="Тема"
                    android:src="@drawable/ic_settings" app:tint="@color/dadway_primary"/>
                <LinearLayout style="@style/DadwaySettingsTextGroup">
                    <TextView style="@style/DadwaySettingsTitle" android:text="Тема оформления"/>
                    <TextView style="@style/DadwaySettingsSubtitle" android:text="Системная, светлая или тёмная"/>
                </LinearLayout>
                <ImageView style="@style/DadwaySettingsChevron"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Локальный прокси работает только во время VPN-подключения"
            android:textColor="@color/dadway_text_secondary"
            android:textSize="10sp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
