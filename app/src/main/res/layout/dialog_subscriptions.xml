<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="8dp"
    android:paddingEnd="20dp" android:paddingBottom="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Серверы загружаются и объединяются из всех активных подписок."
        android:textColor="@color/dadway_text_secondary" android:textSize="13sp"/>
    <LinearLayout android:id="@+id/subscriptionList" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/addSubscriptionButton"
        android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp"
        android:text="Добавить подписку" android:textColor="@color/dadway_primary"
        app:backgroundTint="@color/dadway_surface" app:cornerRadius="18dp"
        app:strokeColor="@color/card_stroke" app:strokeWidth="1dp"/>
</LinearLayout>
