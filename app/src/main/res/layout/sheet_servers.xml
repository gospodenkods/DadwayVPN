<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/sheet_background" android:orientation="vertical"
    android:paddingStart="20dp" android:paddingTop="16dp" android:paddingEnd="20dp" android:paddingBottom="12dp">

    <View android:layout_width="42dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal" android:background="@drawable/sheet_handle"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Выбор сервера" android:textColor="@color/dadway_text"
                android:textSize="24sp" android:textStyle="bold"/>
            <TextView android:id="@+id/serversUpdatedText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Проверка доступности…" android:textColor="@color/dadway_text_secondary"
                android:textSize="13sp"/>
        </LinearLayout>
        <ImageButton android:id="@+id/sheetRefreshButton" android:layout_width="48dp"
            android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Обновить серверы" android:padding="11dp"
            android:src="@drawable/ic_refresh" android:tint="@color/dadway_primary"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:id="@+id/serverListScroll"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="16dp" android:clipToPadding="false"
        android:fadeScrollbars="false" android:fillViewport="false"
        android:overScrollMode="ifContentScrolls" android:paddingBottom="8dp">
        <LinearLayout android:id="@+id/serverList" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"/>
    </androidx.core.widget.NestedScrollView>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center"
        android:text="Прокрутите список, чтобы увидеть остальные серверы"
        android:textColor="@color/dadway_text_secondary" android:textSize="12sp"/>
</LinearLayout>
