<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/rootScroll"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/app_background" android:fillViewport="true"
    android:clipToPadding="false" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/dadway_content_padding" android:paddingEnd="@dimen/dadway_content_padding" android:paddingTop="6dp" android:paddingBottom="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:gravity="center_vertical">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/dadway_shield_smooth_v2" android:contentDescription="@string/app_name"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="9dp" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DADWAY" android:textColor="@color/dadway_primary" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
                        android:text="VPN" android:textColor="@color/dadway_danger" android:textSize="20sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/versionText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Версия 8.5.6" android:textColor="@color/dadway_text_secondary" android:textSize="9sp"/>
                <TextView android:id="@+id/projectHelpLink" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"
                    android:paddingEnd="10dp" android:paddingTop="1dp" android:text="Помощь проекту"
                    android:textColor="@color/dadway_primary" android:textSize="11sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:id="@+id/websiteLink" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center"
                android:text="dadway.ru" android:textColor="@color/dadway_text_secondary" android:textSize="12sp" android:paddingStart="8dp"/>
        </LinearLayout>

        <FrameLayout android:layout_width="@dimen/dadway_connect_size" android:layout_height="@dimen/dadway_connect_size" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp">
            <ImageButton android:id="@+id/connectButton" android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/btn_connect_selector" android:padding="43dp" android:src="@drawable/dadway_shield_smooth_v2"
                android:scaleType="fitCenter" android:contentDescription="@string/connect"/>
            <TextView android:id="@+id/connectCaption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="25dp" android:gravity="center"
                android:text="ПОДКЛЮЧИТЬСЯ" android:textColor="@color/dadway_text" android:textSize="12sp" android:textStyle="bold"/>
        </FrameLayout>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:gravity="center" android:text="Защита выключена"
            android:textColor="@color/dadway_danger" android:textSize="15sp" android:textStyle="bold"/>
        <ImageView android:id="@+id/statusIcon" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Выбранный сервер" android:textColor="@color/dadway_text" android:textSize="15sp" android:textStyle="bold"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/refreshServersButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="42dp"
            android:layout_marginTop="8dp" android:text="ОБНОВИТЬ ДОСТУПНОСТЬ" android:textSize="11sp"
            android:textColor="@color/dadway_primary" app:backgroundTint="@color/dadway_surface" app:cornerRadius="18dp"
            app:icon="@drawable/ic_refresh" app:iconGravity="textStart" app:iconPadding="8dp" app:iconSize="19dp"
            app:iconTint="@color/dadway_primary" app:strokeColor="@color/card_stroke" app:strokeWidth="1dp"/>

        <LinearLayout android:id="@+id/selectedServerCard" android:layout_width="match_parent" android:layout_height="96dp"
            android:layout_marginTop="8dp" android:background="@drawable/card_selected" android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
            <ImageView android:id="@+id/selectedServerFlag" android:layout_width="@dimen/dadway_icon_size" android:layout_height="@dimen/dadway_icon_size" android:scaleType="centerCrop"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/selectedServerName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Загрузка серверов…" android:textColor="@color/dadway_text" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/selectedServerSource" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:ellipsize="middle" android:maxLines="1"
                    android:text="Источник подписки" android:textColor="@color/dadway_text_secondary" android:textSize="10sp"/>
                <TextView android:id="@+id/selectedServerStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:text="Проверка доступности" android:textColor="@color/dadway_text_secondary" android:textSize="12sp"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/dadway_primary" android:textSize="31sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/serverText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:layout_marginTop="12dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/metric_card" android:gravity="center" android:orientation="vertical">
                <TextView android:text="IP" android:textColor="@color/dadway_text_secondary" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/ipText" android:text="—" android:textColor="@color/dadway_success" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/metric_card" android:gravity="center" android:orientation="vertical">
                <TextView android:text="Пинг" android:textColor="@color/dadway_text_secondary" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/pingText" android:text="—" android:textColor="@color/dadway_success" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:layout_marginStart="4dp" android:background="@drawable/metric_card" android:gravity="center" android:orientation="vertical">
                <TextView android:text="Скорость" android:textColor="@color/dadway_text_secondary" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/downloadText" android:text="↓ 0 Б/с" android:textColor="@color/dadway_success" android:textSize="10sp" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/uploadText" android:text="↑ 0 Б/с" android:textColor="@color/dadway_danger" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/totalText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:layout_marginTop="5dp" android:text="↓ 0 Б  •  ↑ 0 Б" android:textColor="@color/dadway_text_secondary" android:textSize="11sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp"
            android:background="@drawable/bottom_nav_bg" android:orientation="horizontal" android:padding="2dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/ipButton" style="@style/DadwayBottomNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Главная" android:textColor="@color/dadway_primary" app:icon="@drawable/ic_check" app:iconTint="@color/dadway_primary"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/testButton" style="@style/DadwayBottomNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Статистика" app:icon="@drawable/ic_speed"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/saveLogsButton" style="@style/DadwayBottomNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Логи" app:icon="@drawable/ic_logs"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/settingsButton" style="@style/DadwayBottomNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Настройки" app:icon="@drawable/ic_settings"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/updateButton" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="8dp" android:text="ОБНОВИТЬ СПИСОК СЕРВЕРОВ" android:textSize="12sp" android:textColor="@color/dadway_primary"
            app:backgroundTint="@color/dadway_surface" app:cornerRadius="18dp" app:strokeColor="@color/card_stroke" app:strokeWidth="1dp"/>
        <TextView android:id="@+id/telegramLink" android:layout_width="match_parent" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"
            android:gravity="center" android:text="Telegram: @gds_technical"
            android:textColor="@color/dadway_text_secondary" android:textSize="10sp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
