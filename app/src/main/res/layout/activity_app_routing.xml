<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appRoutingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/dadway_content_padding"
    android:paddingTop="4dp"
    android:paddingEnd="@dimen/dadway_content_padding"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/appRoutingBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/dadway_text"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Приложения через VPN"
            android:textColor="@color/dadway_text"
            android:textSize="21sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Выберите приложения, которые будут использовать VPN"
        android:textColor="@color/dadway_text_secondary"
        android:textSize="13sp"/>

    <RadioGroup
        android:id="@+id/routingModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/settings_group_bg"
        android:orientation="vertical"
        android:padding="8dp">
        <RadioButton
            android:id="@+id/allAppsRadio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:buttonTint="@color/dadway_primary"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:text="Все приложения\nВесь трафик устройства будет использовать VPN"
            android:textColor="@color/dadway_text"
            android:textSize="12sp"/>
        <RadioButton
            android:id="@+id/selectedAppsRadio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:buttonTint="@color/dadway_primary"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:text="Только выбранные\nТолько отмеченные приложения будут использовать VPN"
            android:textColor="@color/dadway_text"
            android:textSize="12sp"/>
    </RadioGroup>

    <SearchView
        android:id="@+id/appsSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/settings_group_bg"
        android:iconifiedByDefault="false"
        android:queryHint="Поиск приложений"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Установленные приложения"
            android:textColor="@color/dadway_text"
            android:textSize="14sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/selectedAppsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Все"
            android:textColor="@color/dadway_text_secondary"
            android:textSize="12sp"/>
    </LinearLayout>

    <ListView
        android:id="@+id/installedAppsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:overScrollMode="never"
        android:paddingBottom="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Изменения применятся при следующем подключении"
        android:textColor="@color/dadway_text_secondary"
        android:textSize="10sp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveAppRoutingButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="Сохранить"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/dadway_primary"
        app:cornerRadius="22dp"/>
</LinearLayout>
