<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/dadway_background">

    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/dadway_logo_512"
        android:contentDescription="@string/app_name"/>

    <ImageButton
        android:id="@+id/connectButton"
        android:layout_width="320dp"
        android:layout_height="88dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/btn_connect_selector"
        android:contentDescription="@string/connect"/>

    <ImageButton
        android:id="@+id/disconnectButton"
        android:layout_width="320dp"
        android:layout_height="88dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_disconnect_selector"
        android:contentDescription="@string/disconnect"/>
</LinearLayout>
