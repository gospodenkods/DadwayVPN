<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DadwayVPN" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/dadway_primary</item>
        <item name="colorSecondary">@color/dadway_primary_dark</item>
        <item name="colorError">@color/dadway_danger</item>
        <item name="android:windowBackground">@color/dadway_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="DadwayBottomNavButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/dadway_text_secondary</item>
        <item name="android:textSize">8sp</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">21dp</item>
        <item name="iconPadding">2dp</item>
        <item name="iconTint">@color/dadway_text_secondary</item>
        <item name="android:insetTop">1dp</item>
        <item name="android:insetBottom">1dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
    <style name="DadwayPurchaseButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dadway_text</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/dadway_surface</item>
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">19dp</item>
    </style>
    <style name="DadwaySettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
    <style name="DadwaySettingsIcon">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="DadwaySettingsTextGroup">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="DadwaySettingsTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/dadway_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="DadwaySettingsSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/dadway_text_secondary</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style name="DadwaySettingsChevron">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
    </style>
    <style name="DadwaySettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">54dp</item>
        <item name="android:background">@color/card_stroke</item>
    </style>
</resources>
